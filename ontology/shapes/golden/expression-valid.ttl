@prefix djr: <https://numchida.com/ns/djr#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

djr:golden-checker-2 a djr:Checker ;
    skos:prefLabel "골든 검사기 2"@ko .

djr:golden-expr-1 a djr:Expression ;
    prov:specializationOf djr:golden-work-2 ;
    djr:revision 1 .

djr:golden-work-2 a djr:Obligation ;
    skos:prefLabel "골든 규범 2"@ko ;
    djr:enforcedBy djr:golden-checker-2 .
