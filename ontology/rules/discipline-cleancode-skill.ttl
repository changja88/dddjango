    djr:inSection <https://numchida.com/ns/djr#s/dddjango/skills/discipline-cleancode/SKILL.md/s005> ;
    djr:kind djr:kind-norm ;
    djr:order 1 ;
    djr:statesNorm djr:R-3097 ;
    djr:text "\n주제별로 [`references/final.md`](references/final.md)의 해당 절을 따른다:\n\n"@ko .

