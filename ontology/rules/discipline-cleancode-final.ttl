<https://numchida.com/ns/djr#s/dddjango/skills/discipline-cleancode/references/final.md/s140-17.9/b3> a djr:Block ;
    djr:inSection <https://numchida.com/ns/djr#s/dddjango/skills/discipline-cleancode/references/final.md/s140-17.9> ;
