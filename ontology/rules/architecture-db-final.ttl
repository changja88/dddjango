    djr:kind djr:kind-prose ;
    djr:order 7 ;
    djr:text "> 출처: Martin Fowler, [Software Patterns Lexicon - Closure Table](https://softwarepatternslexicon.com/patterns-sql/4/2/4/)\n\n"@ko .

