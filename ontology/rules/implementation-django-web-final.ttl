    djr:order 6 ;
    djr:statesNorm djr:R-2257 ;
    djr:text "| 모델, QuerySet, Manager, migration, transaction | implementation-django | 데이터 구조와 ORM 동작이 중심일 때 |\n" .

<https://numchida.com/ns/djr#s/dddjango/skills/implementation-django-web/references/final.md/s002-1/b7> a djr:Block ;
    djr:inSection <https://numchida.com/ns/djr#s/dddjango/skills/implementation-django-web/references/final.md/s002-1> ;
