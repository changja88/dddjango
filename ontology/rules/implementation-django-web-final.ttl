    djr:order 5 ;
    djr:statesNorm djr:R-2256 ;
    djr:text "| Django Ninja Router/Schema/API 구현 | implementation-django-ninja | JSON API endpoint 구현이 중심일 때 |\n" .

<https://numchida.com/ns/djr#s/dddjango/skills/implementation-django-web/references/final.md/s002-1/b6> a djr:Block ;
