    djr:kind djr:kind-table-row ;
    djr:order 3 ;
    djr:text "| 상황 | 넘길 곳 | 기준 |\n|---|---|---|\n" .

<https://numchida.com/ns/djr#s/dddjango/skills/implementation-django-web/references/final.md/s002-1/b4> a djr:Block ;
    djr:inSection <https://numchida.com/ns/djr#s/dddjango/skills/implementation-django-web/references/final.md/s002-1> ;
