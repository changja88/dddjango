<https://numchida.com/ns/djr#s/dddjango/skills/implementation-test/references/final.md/s106-21/b1> a djr:Block ;
    djr:inSection <https://numchida.com/ns/djr#s/dddjango/skills/implementation-test/references/final.md/s106-21> ;
    djr:kind djr:kind-norm ;
    djr:order 1 ;
    djr:statesNorm djr:R-1932 ;
    djr:text "\n범용 Python 디버깅(repr, pdb, breakpoint)은 `implementation-python` 스킬을 참조한다.\n\n"@ko .
