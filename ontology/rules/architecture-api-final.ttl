<https://numchida.com/ns/djr#s/dddjango/skills/architecture-api/references/final.md/s065-14.3/b1> a djr:Block ;
    djr:inSection <https://numchida.com/ns/djr#s/dddjango/skills/architecture-api/references/final.md/s065-14.3> ;
    djr:kind djr:kind-norm ;
