    djr:order 5 ;
    djr:statesNorm djr:R-1942 ;
    djr:text "| 202 | Accepted | 비동기 처리 접수됨 (배치, 장시간 작업) |\n" .

<https://numchida.com/ns/djr#s/dddjango/skills/architecture-api/references/final.md/s018-4.2/b6> a djr:Block ;
