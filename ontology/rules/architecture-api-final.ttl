    djr:order 8 ;
    djr:text "구체적인 것이 우선한다.\n\n"@ko .

<https://numchida.com/ns/djr#s/dddjango/skills/architecture-api/references/final.md/s033-7.2/b9> a djr:Block ;
    djr:inSection <https://numchida.com/ns/djr#s/dddjango/skills/architecture-api/references/final.md/s033-7.2> ;
