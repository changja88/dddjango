    djr:order 4 ;
    djr:statesNorm djr:R-1941 ;
    djr:text "| 201 | Created | POST로 자원 생성 성공. Location 헤더에 새 자원 URI |\n" .

<https://numchida.com/ns/djr#s/dddjango/skills/architecture-api/references/final.md/s018-4.2/b5> a djr:Block ;
