<https://numchida.com/ns/djr#s/dddjango/skills/architecture-api/references/final.md/s061-13.4/b1> a djr:Block ;
    djr:inSection <https://numchida.com/ns/djr#s/dddjango/skills/architecture-api/references/final.md/s061-13.4> ;
    djr:kind djr:kind-norm ;
