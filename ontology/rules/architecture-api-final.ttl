<https://numchida.com/ns/djr#s/dddjango/skills/architecture-api/references/final.md/s033-7.2/b6> a djr:Block ;
    djr:inSection <https://numchida.com/ns/djr#s/dddjango/skills/architecture-api/references/final.md/s033-7.2> ;
    djr:kind djr:kind-prose ;
