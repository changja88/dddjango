    djr:text "|------|----------|--------|--------|------------|\n" .

<https://numchida.com/ns/djr#s/dddjango/skills/architecture-ddd/references/final.md/s008-2.2/b6> a djr:Block ;
    djr:inSection <https://numchida.com/ns/djr#s/dddjango/skills/architecture-ddd/references/final.md/s008-2.2> ;
