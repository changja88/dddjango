<https://numchida.com/ns/djr#s/dddjango/skills/implementation-python/references/final.md/s109-19.4/b1> a djr:Block ;
    djr:inSection <https://numchida.com/ns/djr#s/dddjango/skills/implementation-python/references/final.md/s109-19.4> ;
    djr:kind djr:kind-norm ;
    djr:order 1 ;
