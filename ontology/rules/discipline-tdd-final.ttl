<https://numchida.com/ns/djr#s/dddjango/skills/discipline-tdd/references/final.md/s012-3.4/b4> a djr:Block ;
    djr:inSection <https://numchida.com/ns/djr#s/dddjango/skills/discipline-tdd/references/final.md/s012-3.4> ;
