    djr:sectionNumber "6.3" ;
    djr:sectionOwner djr:owner-graph .

<https://numchida.com/ns/djr#s/dddjango/skills/discipline-tdd/references/final.md/s029-6.3/b1> a djr:Block ;
    djr:inSection <https://numchida.com/ns/djr#s/dddjango/skills/discipline-tdd/references/final.md/s029-6.3> ;
    djr:kind djr:kind-norm ;
    djr:order 1 ;
    djr:statesNorm djr:R-2193, djr:R-2194 ;
    djr:text "\n단순한 연산들은 그냥 구현해버린다. 어떻게 구현해야 할지 확신이 들면 그렇게 하는 것이 좋다.\n\n"@ko .

<https://numchida.com/ns/djr#s/dddjango/skills/discipline-tdd/references/final.md/s029-6.3/b2> a djr:Block ;
