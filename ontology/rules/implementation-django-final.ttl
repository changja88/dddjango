    djr:order 2 ;
    djr:text "**시그널을 피해야 하는 경우:**\n"@ko .

<https://numchida.com/ns/djr#s/dddjango/skills/implementation-django/references/final.md/s047-9.2/b3> a djr:Block ;
    djr:inSection <https://numchida.com/ns/djr#s/dddjango/skills/implementation-django/references/final.md/s047-9.2> ;
    djr:kind djr:kind-norm ;
