<https://numchida.com/ns/djr#s/dddjango/skills/implementation-django/references/final.md/s047-9.2/b6> a djr:Block ;
    djr:inSection <https://numchida.com/ns/djr#s/dddjango/skills/implementation-django/references/final.md/s047-9.2> ;
    djr:kind djr:kind-prose ;
