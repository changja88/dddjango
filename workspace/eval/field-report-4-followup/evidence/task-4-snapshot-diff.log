+            env[arg.arg] = origin(address(arg.annotation, env))
+        for arg in (fn.args.vararg, fn.args.kwarg):
+            if arg: env[arg.arg] = ""
+
+    # 모듈의 사후 재바인딩도 함수 실행 시 출처를 바꾼다. 순서 의존 호출은 확정하지 않는다.
+    rebound = set()
