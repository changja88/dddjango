     skos:prefLabel "slot 11 — slot 10의 internal failure 형태에 따른 두 path(exception·조회 `None`) 중 하나 선택 확인"@ko ;
@@ -1099,21 +1105,21 @@ djr:R-2709 a djr:Prohibition ;
