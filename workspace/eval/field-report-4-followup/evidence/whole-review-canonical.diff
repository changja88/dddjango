+    members = 0
+    for st in cls.body:
+        if isinstance(st, (ast.FunctionDef, ast.AsyncFunctionDef)):
+            if st.name in {"_missing_", "__new__", "__init__", "__call__"}: return False, enum_based
+        elif isinstance(st, (ast.Assign, ast.AnnAssign)):
