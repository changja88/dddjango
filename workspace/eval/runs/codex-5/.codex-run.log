+            return True
+    return False
+
+
+def _parse_accept_item(item: str) -> tuple[str, float]:
+    parts = [part.strip() for part in item.split(";") if part.strip()]
+    if not parts:
+        return "", 0
+
+    quality = 1.0
+    for parameter in parts[1:]:
+        name, separator, value = parameter.partition("=")
