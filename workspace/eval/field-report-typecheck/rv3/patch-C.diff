+def _import_bindings(mod: ast.Module) -> dict[str, str]:
+    """모듈 본문(if/try 하위 문 포함)의 import 바인딩 — 로컬 이름 → 원명.
+
+    `from enum import StrEnum as _StrEnum` → {"_StrEnum": "StrEnum"} ·
+    `import enum as e` → {"e": "enum"}. 함수·클래스 본문 안 import 는 보지 않는다."""
+    bindings: dict[str, str] = {}
+
+    def walk(stmts: list[ast.stmt]) -> None:
+        for st in stmts:
+            if isinstance(st, ast.ImportFrom):
+                for a in st.names:
+                    bindings[a.asname or a.name] = a.name
+            elif isinstance(st, ast.Import):
+                for a in st.names:
+                    top: str = a.name.split(".")[0]
+                    bindings[a.asname or top] = a.name if a.asname else top
+            elif isinstance(st, ast.If):
+                walk(st.body)
+                walk(st.orelse)
+            elif isinstance(st, ast.Try):
+                walk(st.body)
+                for h in st.handlers:
+                    walk(h.body)
+                walk(st.orelse)
+                walk(st.finalbody)
+
+    walk(mod.body)
+    return bindings
+
+
