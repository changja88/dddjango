    "code": "def render_situation(templates, situation, subject):\n    if situation not in templates:\n        raise InvalidSpeechSituation(f\"안내 발화 표에 없는 상황입니다: {situation}\")\n    line = templates[situation]\n    if \"{subject}\" not in line:\n        return line\n    if subject is None or not subject.strip():\n        raise InvalidSpeechSituation(f\"상황이 요구하는 subject 부재: {situation}\")\n    return line.format(subject=subject)\n",
