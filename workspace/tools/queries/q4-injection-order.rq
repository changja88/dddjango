# T2-4 사전 검증 질의 ④ — 주입 조립(번호·명칭 + 정렬 키)
#
# 용도: C암 selector 가 쓰는 `rulepack.json` 의 `works`·`order_key` **물질화**.
# 계약(사후 리뷰 AS-15): 입력 없이 **전량 반환**이 계약이다 — 팩을 통째로 굽는 질의이고,
#       위반별 좁히기는 런타임의 `Rulepack.locate` 가 인덱스 조회로 수행한다.
# 계약: Work 1건당 1행. 한 Work 를 진술하는 블록이 둘 이상이면 생성기가 fail-closed 한다
#       (실측 2026-08-20: statesNorm 125 트리플 = 고유 Work 125 → 1:1).
# 주의: 무앵커 절(sectionNumber 부재 — (전문)·frontmatter·h1)도 전량 포함한다(T3 q4 개정 —
#       «전량 반환이 계약»의 전량이 이제 진짜 전량이다). 최종 정렬은 생성기가 절 IRI 말단
#       서수(sNNN) 키로 소유한다 — 여기 ORDER BY 는 안정성 보조일 뿐이다.
# 금지: 블록 리터럴(`djr:text`)은 **뽑지 않는다** — 설치본 팩에 규범 본문을 싣지 않는다
#       (동결 E8 «전체 규범 재주입 금지» · 절차 정본 step 6′ · 개정 8).
PREFIX djr: <https://numchida.com/ns/djr#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT ?work ?label ?document ?section ?sectionNumber ?block ?blockOrder ?expression
       (GROUP_CONCAT(DISTINCT STR(?checker); separator="\u001F") AS ?checkers)
       (GROUP_CONCAT(DISTINCT STR(?agent); separator="\u001F") AS ?agents)
       (GROUP_CONCAT(DISTINCT STR(?aliasText); separator="\u001F") AS ?aliases)
WHERE {
  ?block djr:statesNorm ?work ;
         djr:inSection ?section ;
         djr:order ?blockOrder .
  ?section djr:inDocument ?document .
  OPTIONAL { ?section djr:sectionNumber ?sectionNumber }
  ?work skos:prefLabel ?label .
  OPTIONAL { ?work djr:currentExpression ?expression }
  OPTIONAL { ?work djr:enforcedBy ?checker }
  OPTIONAL { ?work djr:delegatedTo ?agent }
  OPTIONAL { ?aliasNode djr:aliasFor ?work ; djr:aliasText ?aliasText }
}
GROUP BY ?work ?label ?document ?section ?sectionNumber ?block ?blockOrder ?expression
ORDER BY ?document ?sectionNumber ?blockOrder ?work
