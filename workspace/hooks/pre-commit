#!/bin/sh
# 온톨로지 정본 pre-commit 훅 (T0 A8 — D2 승인 규약)
# 변경된 ontology/**/*.ttl 한정 경량 게이트: 4단 게이트(④는 vocab+wiring 병합) + shapes 변경 시 meta-SHACL 2층.
# 퇴행 조건: ttl 변경 없음 → 즉시 exit 0 · .venv 부재+ttl 변경 → fail-closed(설치 안내).
# 훅 단일 루트 = workspace/hooks (설치: make ontology-hooks · 해제: git config --unset core.hooksPath)

changed=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^ontology/.*\.ttl$' || true)
# T1-4 트리거 2축: 코퍼스 md 변경 시 stdlib 검사만(원장 부식·그래프 소유 절 무단 수정 — .venv 불요).
# 렌더 full 검증(rdflib)은 verify·릴리즈 2점 — 절충임을 자인(t1-plan §2 T1-4).
changed_md=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^dddjango/(skills|agents|commands)/.*\.md$' || true)
if [ -n "$changed_md" ]; then
    echo "[pre-commit] 코퍼스 md 변경 — 원장 부식 검사(stdlib)"
    python3 workspace/tools/ontology_ledger_check.py || {
        echo "[pre-commit] 원장 위반 — 정당한 산문 개정이면 LEDGER.tsv 재기준선 append(새 해시+사유), 그래프 소유 절이면 rules 정본에서 수정"
        exit 1
    }
fi
if [ -z "$changed" ]; then
    exit 0
fi

if [ ! -x .venv/bin/python ]; then
    echo "[pre-commit] ontology/ ttl 변경이 스테이지돼 있으나 .venv 부재 — make ontology-env 실행 후 재시도 (fail-closed)"
    exit 1
fi

echo "[pre-commit] 온톨로지 게이트: $(echo "$changed" | tr '\n' ' ')"
PYTHONPATH=workspace/tools .venv/bin/python workspace/tools/ontology_gate.py $changed || exit 1

if echo "$changed" | grep -q '^ontology/shapes/'; then
    PYTHONPATH=workspace/tools .venv/bin/python workspace/tools/ontology_meta_shacl.py || exit 1
fi

exit 0
