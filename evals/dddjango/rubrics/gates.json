      "Handoff Contract",
      "Integration Checklist",
      "Domain Agent",
      "DB Agent",
      "API Agent",
      "Test Agent"
    ],
    "message": "단순 작업에서 불필요한 subagent ceremony를 만들면 실패한다."
  },
  "subagent_required_role_table": {
    "severity": "critical",
    "dimensions": [
      "subagent_role_decomposition",
      "subagent_skill_mapping",
      "subagent_execution_planning"
    ],
    "pass_if_all": [
