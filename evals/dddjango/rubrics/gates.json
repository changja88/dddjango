  "subagent_domain_contract_first": {
    "severity": "major",
    "dimensions": [
      "subagent_execution_planning",
      "subagent_integration_verification",
      "ddd_boundaries"
    ],
    "pass_if_ordered_any": [
      [
        "Domain Agent",
        "DB Agent"
      ],
      [
        "Domain Agent",
