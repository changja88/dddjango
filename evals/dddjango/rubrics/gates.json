{
  "no_drf": {
    "severity": "critical",
    "dimensions": [
      "drf_rejection",
      "django_ninja_api"
    ],
    "fail_if_regex": [
      "\\bfrom\\s+rest_framework\\b",
      "\\bimport\\s+rest_framework\\b",
      "\\bclass\\s+\\w+Serializer\\s*\\(\\s*serializers\\.",
      "\\bclass\\s+\\w+ViewSet\\b",
      "\\bclass\\s+\\w+APIView\\b",
      "\\brouter\\.register\\("
    ],
    "message": "DRF 패턴을 생성하거나 권장하면 실패한다."
  },
  "django_ninja_for_api": {
    "severity": "critical",
    "dimensions": [
      "django_ninja_api"
    ],
    "pass_if_all_regex": [
      "\\bRouter\\s*\\(",
      "\\bclass\\s+\\w+\\s*\\(\\s*Schema\\s*\\)",
      "response\\s*=\\s*\\{"
    ],
    "message": "API 구현/설계 요청은 Django Ninja Router와 Schema를 포함해야 한다."
  },
  "no_false_execution": {
    "severity": "critical",
    "dimensions": [
      "usability"
    ],
    "fail_if_regex": [
      "(?<!하지\\s)(실행했|실행했습니다|실행 완료)",
      "테스트(가)?\\s*(통과|성공)",
      "pytest\\s+(passed|성공|통과)"
    ],
    "message": "실제로 수행하지 않은 테스트나 검증을 수행했다고 주장하면 실패한다."
  },
  "korean_first": {
    "severity": "critical",
    "dimensions": [
      "usability"
    ],
    "min_hangul_ratio": 0.08,
    "message": "한국어 요청에는 한국어 중심 답변이어야 한다."
  },
  "domain_logic_outside_router": {
    "severity": "major",
    "dimensions": [
      "ddd_boundaries",
      "clean_implementation"
    ],
    "fail_if_regex": [
      "@router\\.(post|get|put|patch|delete)[\\s\\S]{0,500}(if\\s+.*status|for\\s+.*items|discount|inventory|cancel)"
    ],
    "message": "비즈니스 규칙을 router/view에 직접 몰아넣으면 실패한다."
  },
  "project_structure_required": {
    "severity": "critical",
    "dimensions": [
      "project_structure",
      "clean_implementation"
    ],
    "pass_if_all": [
      "domain/",
      "services.py",
      "api/",
      "schemas.py",
      "tests/"
    ],
    "message": "구현 구조 요청은 domain, service/usecase, API schema/router, tests 경계를 보여야 한다."
  },
  "db_consistency_required": {
    "severity": "critical",
    "dimensions": [
      "db_transaction"
    ],
    "pass_if_all_regex": [
      "transaction\\.atomic|transaction|트랜잭션",
      "idempotency|Idempotency-Key|멱등|select_for_update|optimistic locking|낙관적 잠금|version|UniqueConstraint"
    ],
    "message": "동시성/중복 요청이 있는 작업은 transaction boundary와 일관성 장치를 포함해야 한다."
  },
  "tdd_red_first": {
    "severity": "critical",
    "dimensions": [
      "tdd_pytest"
    ],
    "pass_if_ordered_any": [
      [
        "RED",
        "GREEN",
        "REFACTOR"
      ],
      [
        "실패 테스트",
        "최소 구현",
        "리팩터링"
      ],
      [
        "실패하는 테스트",
        "통과시키",
        "리팩터링"
      ]
    ],
    "message": "TDD 요청은 RED, GREEN, REFACTOR 순서를 지켜야 한다."
  },
  "no_false_subagents": {
    "severity": "critical",
    "dimensions": [
      "subagent_workflow",
      "subagent_claim_integrity",
      "usability"
    ],
    "fail_if_regex": [
      "subagent(를)?\\s*(실행|호출|사용).*완료",
      "서브\\s*에이전트(를)?\\s*(실행|호출|사용).*완료",
      "(Domain|Architecture|DB|API|Django|Test|Review) Agent(에게|가|는)?\\s*(맡겼|검토했|확인했|완료했|결과를\\s*받)",
      "에이전트(들)?(이|가)?\\s*(병렬\\s*)?(검토했|확인했|완료했|결과를\\s*반환)",
      "subagent(들)?(이|가)?\\s*(검토했|확인했|완료했|결과를\\s*반환)"
    ],
    "message": "subagent를 실제로 쓰지 않았는데 사용했다고 말하면 실패한다."
  },
  "subagent_no_ceremony_for_simple_task": {
